{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zhiye-knowledge",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist", "binding": "ASSETS", "run_worker_first": true,
    "html_handling": "auto-trailing-slash", "not_found_handling": "none"
  },
  "vars": { "AUTH_PROVIDERS": "invite", "ACCESS_POLICY": "invite", "SESSION_TTL_SECONDS": "604800" },
  "d1_databases": [{
    "binding": "DB", "database_name": "zhiye-knowledge-auth",
    "database_id": "3084771a-18b2-4c24-9174-0268dfe93427", "migrations_dir": "migrations"
  }],
  "observability": { "enabled": false }
}
