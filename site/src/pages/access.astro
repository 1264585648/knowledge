---
import Base from '../layouts/Base.astro';
import InviteLogin from '../components/auth/InviteLogin.astro';
---
<Base title="登录" publicPage>
  <section class="access-panel"><span class="topic-mark" aria-hidden="true">▤</span><p class="eyebrow">一本持续生长的知识笔记</p><h1>凭邀请码，<br />继续阅读。</h1><p class="lead">知页记录学习、实践与思考。输入你的专属邀请码，翻开文章与专题。</p>
    <InviteLogin />
    <p class="meta">仅使用必要的信息维护登录和阅读权限。<a href="/privacy/">查看隐私说明 →</a></p>
  </section>
  <script is:inline src="/public/access.js" defer></script>
</Base>
