---
import { render } from 'astro:content';
import ArticleReader from '../../components/ArticleReader.astro';
import { publishedArticles, adjacentArticles, readingMinutes } from '../../data/articles';
export async function getStaticPaths() {
  const articles = await publishedArticles();
  return articles.map(article => ({ params: { id: article.id }, props: { article, articles } }));
}
const { article, articles } = Astro.props;
const { Content, headings } = await render(article);
const { previous, next } = adjacentArticles(articles, article);
---
<ArticleReader article={article} articles={articles} headings={headings}
  minutes={readingMinutes(article.body)} previous={previous} next={next}>
  <Content />
</ArticleReader>
